# Operation Exit — environment variables
# Every variable below is OPTIONAL. The app builds and runs with all of them
# absent, using local mock fallbacks (no AI) and localStorage (no server store).

# --- OpenAI (server-side only; NEVER exposed to the browser) ---
# If missing, every AI endpoint returns 200 with { "fallback": true } and the
# mock-shaped object, so the UI keeps working.
OPENAI_API_KEY=

# Model for judgment-heavy endpoints (coach, resume analyze, job score, tailor, interview).
OPENAI_MODEL=gpt-5-mini

# Model for low-complexity endpoints (outreach, recovery). Defaults to OPENAI_MODEL
# if unset. Point this at a nano-tier model to save cost.
OPENAI_MODEL_CHEAP=

# --- Lightweight access gate (OPTIONAL) ---
# If set, all /api/* routes (except /api/health) require:
#   Authorization: Bearer <token>
# HONESTY NOTE: when the client sends this token it lives in the browser bundle,
# so this is a "keep randoms out" gate, NOT real authentication.
OPERATION_EXIT_OWNER_TOKEN=

# Client-side copy of the token above. This is the ONLY VITE_ var that may exist.
# Never expose any OpenAI variable with a VITE_ prefix.
VITE_OPERATION_EXIT_OWNER_TOKEN=

# --- State persistence (OPTIONAL) ---
# Postgres/Supabase/Neon connection string for the single state blob. If unset,
# persistence uses the local JSON file in dev and is a graceful no-op on Vercel.
#
# Postgres drop-in (run the DDL once, then `npm i pg`):
#   create table operation_exit_state (
#     user_id    text primary key,
#     data       jsonb not null,
#     updated_at timestamptz not null default now()
#   );
DATABASE_URL=

# When true (default) and DATABASE_URL is unset and not running on Vercel,
# the state store writes to server/data/operation-exit-db.json.
USE_LOCAL_JSON_DB=true
